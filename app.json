{
  "expo": {
    "name": "HypeJuice",
    "slug": "hypejuice",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": ["hypejuice", "growthbanana"],
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/hypejuice-logo.png",
    "splash": {
      "image": "./assets/brand/hypejuice-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4EA"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose videos showing your app in action for HypeJuice demo clips.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Choose videos showing your app in action for HypeJuice demo clips.",
          "savePhotosPermission": "Save your finished HypeJuice videos to your photo library.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growthbanana.app"
    },
    "android": {
      "package": "com.growthbanana.app"
    },
    "web": {
      "bundler": "metro",
      "name": "HypeJuice",
      "shortName": "HypeJuice",
      "favicon": "./assets/brand/hypejuice-logo.png"
    }
  }
}
