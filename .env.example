# Mobile app -> local API. For a physical phone, use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Production builds REQUIRE an https:// API URL. Only these PUBLIC Supabase values go in Expo.
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Authenticated mode is the default. Local prototype mode requires BOTH AUTH_MODE=local
# and STUDIO_ALLOW_UNAUTHENTICATED=true, and is forbidden in production/release builds.
AUTH_MODE=supabase
PUBLIC_API_URL=https://your-api-domain.example
# Explicit browser origins, comma-separated. Native bearer-token clients don't need an Origin.
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8083
RUN_GENERATION_WORKER=true
# Keep off until cost limits/billing policy and deployment security are verified.
ENABLE_PAID_GENERATION=false

# RevenueCat SDK integration; leave keys empty until setting up products/testing.
# Public SDK keys only; never put an sk_ secret in an EXPO_PUBLIC_ variable.
# Test Store is selected only in debug/development, never in release builds.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Server-only V1 secret API key, used to verify subscriptions independently.
REVENUECAT_SECRET_API_KEY=
# Local prototype stays unlocked until this is true. Authenticated mode always enforces.
REVENUECAT_ENFORCE_ENTITLEMENTS=false
# Opt in later for Test Store/platform sandbox testing; ignored in production.
REVENUECAT_ALLOW_SANDBOX=false

# Server-only. Never prefix this key with EXPO_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=8787

# Real Studio video generation: all server-only. Never use EXPO_PUBLIC_ here.
HF_CREDENTIALS=your_higgsfield_key_id:your_higgsfield_key_secret
# Optional: only needed to recover/poll older Creatomate jobs. New jobs use FFmpeg.
# CREATOMATE_API_KEY=your_creatomate_api_key
# Install ffmpeg + ffprobe on the API server; override paths only if needed.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Create this PRIVATE Storage bucket in Supabase; allow video uploads up to 250 MB.
SUPABASE_STUDIO_BUCKET=growthbanana-studio
# Enable only for your own computer/trusted LAN. Anyone who can reach this API
# can access Studio media and spend provider credits. Never expose via public URLs
# or tunnels. Production use requires authentication; no code is entered in the app.
STUDIO_ALLOW_UNAUTHENTICATED=false

# Optional per-user YouTube connection; server-only. Upload/publishing not enabled yet.
YOUTUBE_CLIENT_ID=your_google_web_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_web_oauth_client_secret
# Generate once locally: openssl rand -base64 32. Keep stable in your hosting secret store.
CONNECTION_ENCRYPTION_KEY=your_base64_32_byte_encryption_key
YOUTUBE_PUBLIC_SCHEDULING_ENABLED=false

# Manual-post metrics: server-only Google API key with YouTube Data API v3 enabled.
# Restrict the key to that API (and your server IP where feasible), never EXPO_PUBLIC_.
# Independent from OAuth client credentials and Gemini; does not upload anything.
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key
RUN_YOUTUBE_TRACKING_WORKER=true

# Discover uses Gemini + saved creators + local FFmpeg, never Higgsfield generation.
# Optional operator-curated catalog override (id, private creator/*.mp4 path, description).
# Authenticated mode reads catalog creator/*.mp4 paths under shared/creator/*.mp4.
# The default catalog names two legacy test clips; upload your own licensed copies
# to the shared prefix explicitly. Private user Studio clips are never auto-shared.
# Other self-hosted installs must supply their own licensed clips and catalog paths.
# DISCOVER_CREATOR_LIBRARY=/absolute/path/to/creator-library.json
